---
import Layout from "../components/layout/index.astro";
import SimpleExample from "../components/simple-example/index.tsx";
import "../styles/themes/core.css";
import "../styles/themes/catppuccin.css";

const swatches = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950, 1000];
---

<div class="surface" data-scheme="dark">
    <Layout>
        <h2>Soothing pastel theme</h2>
        <h1>Catppuccin</h1>
        <p>
            Catppuccin consists of 4 beautiful pastel color palettes, named
            flavors. The theme comes in one light and three dark variants.
        </p>
        <div>
            <button>Learn more</button>
        </div>
        <div class="surface">
            <h3>For the high-spirited!</h3>
            <p>
                A community-driven color scheme meant for coding, designing, and
                much more!
            </p>
        </div>
        <div class="surface" data-scope="secondary">
            <h3>For the high-spirited!</h3>
            <p>
                A community-driven color scheme meant for coding, designing, and
                much more!
            </p>
            <div class="surface" data-scope="tertiary"></div>
        </div>
        <div class="surface" data-scope="tertiary">
            <h3>For the high-spirited!</h3>
            <p>
                A community-driven color scheme meant for coding, designing, and
                much more!
            </p>
        </div>
        <!-- <SimpleExample client:load /> -->
    </Layout>
</div>

<style>
    .surface {
        display: grid;
        gap: 0.5rem;
        grid-auto-rows: max-content;
        background: var(--color-background);
        border: 1px solid var(--color-border);
        color: var(--color-foreground-primary);
        min-height: 200px;
        padding: 1rem;

        h1 {
            line-height: 1.2;
            font-weight: 800;
        }

        h2 {
            font-size: 0.9125rem;
            font-weight: 600;
            color: var(--color-accent);
        }

        h3 {
            font-size: 2rem;
        }

        h4 {
            color: var(--color-accent);
        }

        p {
            color: var(--color-foreground-secondary);
        }

        button {
            background: var(--color-action-background);
            border: 1px solid var(--color-action-border);
            color: var(--color-action-foreground);
            font-weight: 700;
            padding: 0.5rem 1rem;
        }
    }
</style>
